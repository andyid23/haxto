<p><kuis-ledakan questions="[{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Apa kekurangan utama dari metode Membaca Vertikal dalam mengevaluasi informasi digital?&quot;,&quot;hint&quot;:&quot;Fokus pada risiko keterpukauan pada tampilan internal situs.&quot;,&quot;choices&quot;:[&quot;Membutuhkan waktu yang terlalu lama untuk membaca&quot;,&quot;Hanya dapat digunakan untuk situs berbahasa Indonesia&quot;,&quot;Mengandalkan elemen visual internal yang mudah dipalsukan&quot;,&quot;Tidak dapat digunakan pada situs dengan protokol HTTPS&quot;,&quot;Membawa risiko kerusakan sistem komputasi lokal secara otomatis&quot;],&quot;correctIndex&quot;:2},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Seorang siswa menemukan artikel kontroversial mengenai 'bahaya radiasi ponsel' di sebuah situs tidak dikenal. Berdasarkan konsep membaca lateral pada Stimulus A, tindakan pertama manakah yang paling tepat dan taktis untuk dilakukan?&quot;,&quot;hint&quot;:&quot;Ciri utama membaca lateral adalah keluar dari halaman asal untuk memverifikasi ke luar.&quot;,&quot;choices&quot;:[&quot;Membaca artikel tersebut secara saksama dari paragraf pertama hingga terakhir tanpa terputus&quot;,&quot;Membagikan artikel tersebut langsung ke media sosial agar mendapat tanggapan dari orang lain&quot;,&quot;Keluar dari situs tersebut, membuka tab baru di peramban, dan mencari verifikasi dari situs resmi seperti WHO atau Kementerian Kesehatan&quot;,&quot;Memeriksa apakah situs web tersebut menggunakan hiasan gambar yang estetik dan tata bahasa yang rumit&quot;,&quot;Menyalin teks artikel tersebut ke dalam Google Docs untuk dianalisis struktur kalimatnya&quot;],&quot;correctIndex&quot;:2},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Protokol HTTPS menjamin hal berikut, KECUALI...&quot;,&quot;hint&quot;:&quot;HTTPS mengamankan jalur transmisi, namun tidak menyaring kebenaran isi konten.&quot;,&quot;choices&quot;:[&quot;Keamanan transmisi data dari penyadapan pihak ketiga&quot;,&quot;Penggunaan enkripsi SSL/TLS untuk melindungi data&quot;,&quot;Kebenaran dan validitas informasi di dalam situs&quot;,&quot;Perlindungan data antara klien dan server&quot;,&quot;Enkripsi persandian asimetris jalur transmisi&quot;],&quot;correctIndex&quot;:2},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Metode triangulasi dalam verifikasi informasi bertujuan untuk...&quot;,&quot;hint&quot;:&quot;Pikirkan manfaat penggabungan beberapa sumber untuk memvalidasi data.&quot;,&quot;choices&quot;:[&quot;Mempercepat proses pencarian informasi di internet&quot;,&quot;Memperkuat validitas data dengan membandingkan beberapa sumber&quot;,&quot;Menghindari penggunaan situs dengan protokol HTTPS&quot;,&quot;Membuat konten menjadi lebih menarik secara visual&quot;,&quot;Menghapus data cache lama dari server secara otomatis&quot;],&quot;correctIndex&quot;:1},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Dalam metode triangulasi, bias konfirmasi merupakan salah satu ancaman utama yang harus dihindari. Mengapa bias konfirmasi dianggap berbahaya bagi seorang warga digital dalam menerima informasi politik di internet?&quot;,&quot;hint&quot;:&quot;Bias ini membuat orang hanya mencari pembenaran atas opini pribadinya.&quot;,&quot;choices&quot;:[&quot;Karena membuat server database internet mengalami kelebihan beban pemrosesan&quot;,&quot;Karena secara tidak sadar mendorong seseorang hanya mencari bukti yang mendukung opini pribadinya dan mengabaikan fakta sebaliknya&quot;,&quot;Karena memicu peretasan akun media sosial melalui infeksi virus secara massal&quot;,&quot;Karena memaksa peramban menghapus riwayat pencarian secara otomatis&quot;,&quot;Karena melanggar hukum hak cipta UU ITE secara langsung&quot;],&quot;correctIndex&quot;:1},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Ketika melakukan riset kesehatan secara daring, misalnya tentang efek samping vaksin, kita sering menemukan artikel dari situs berita terkenal yang mapan dan tulisan dari blog pribadi yang tidak dikenal. Berdasarkan konsep perbaikan kredibilitas informasi, mengapa riwayat publikasi (publication history) dari suatu sumber daring sangat penting untuk dievaluasi sebelum kita mempercayai informasinya?&quot;,&quot;hint&quot;:&quot;Riwayat publikasi berfungsi seperti rekam jejak atau portofolio reputasi.&quot;,&quot;choices&quot;:[&quot;Karena riwayat publikasi menentukan kecepatan loading halaman web saat diakses melalui peramban&quot;,&quot;Karena sumber yang telah membangun reputasi baik dalam menghasilkan konten berkualitas sebelumnya memberikan dasar yang lebih solid untuk mempercayai keakuratan informasi mereka&quot;,&quot;Karena riwayat publikasi secara otomatis mengenkripsi data sensitif pengguna menggunakan SSL/TLS&quot;,&quot;Karena hanya situs dengan riwayat publikasi panjang yang dapat menampilkan file berformat dokumen PDF&quot;,&quot;Karena riwayat publikasi menjamin bahwa situs tersebut bebas dari iklan komersial yang mengganggu&quot;],&quot;correctIndex&quot;:1},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Seorang jurnalis menemukan foto kerusakan infrastruktur yang diklaim terjadi akibat bencana gempa bumi hari ini. Setelah melakukan Reverse Image Search, ia menemukan bahwa foto tersebut sebenarnya sudah pernah diunggah di sebuah portal berita luar negeri pada tahun 2018. Kesimpulan manakah yang dapat ditarik jurnalis tersebut?&quot;,&quot;hint&quot;:&quot;Memakai foto lama untuk narasi baru adalah bentuk manipulasi konteks.&quot;,&quot;choices&quot;:[&quot;Foto tersebut 100% asli dan relevan dengan gempa bumi hari ini&quot;,&quot;Foto tersebut kredibel karena disajikan dalam resolusi tinggi dan tajam&quot;,&quot;Foto tersebut merupakan hoaks konteks karena diposting kembali di luar konteks waktu aslinya&quot;,&quot;Metadata EXIF dari foto tersebut telah dienkripsi secara otomatis oleh satelit&quot;,&quot;Situs web pengunggah pertama foto tersebut terindikasi tidak memiliki sertifikat HTTPS&quot;],&quot;correctIndex&quot;:2},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Mengapa metadata EXIF pada gambar tidak boleh dipercaya secara mutlak?&quot;,&quot;hint&quot;:&quot;Pertimbangkan kemudahan penyuntingan file metadata oleh perangkat lunak.&quot;,&quot;choices&quot;:[&quot;Karena metadata EXIF tidak pernah tersedia di file gambar digital&quot;,&quot;Karena metadata EXIF sangat rentan dihapus atau dimanipulasi&quot;,&quot;Karena metadata EXIF hanya tersedia pada foto yang diambil dengan kamera profesional&quot;,&quot;Karena metadata EXIF tidak mengandung informasi yang berguna&quot;,&quot;Karena pembacaan data EXIF dapat menyebabkan kerusakan enkripsi file gambar secara permanen&quot;],&quot;correctIndex&quot;:1},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Aspek 'Kebenaran Visual' dalam mengevaluasi kualitas gambar digital dilakukan dengan cara...&quot;,&quot;hint&quot;:&quot;Periksa apakah ada rekayasa atau suntingan digital yang memalsukan gambar.&quot;,&quot;choices&quot;:[&quot;Menghitung jumlah total bit warna dari file gambar biner&quot;,&quot;Memastikan gambar yang diunggah tidak memiliki ukuran file yang melebihi 64 KiB&quot;,&quot;Mendeteksi tanda-tanda manipulasi, rekayasa digital, atau penyuntingan yang tidak jujur pada objek gambar&quot;,&quot;Mengubah format file gambar dari PNG menjadi format presentasi PPT&quot;,&quot;Menggunakan mesin pencari Google Docs untuk membuat daftar rujukan gambar&quot;],&quot;correctIndex&quot;:2},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Seorang siswa menemukan dua artikel yang membahas topik perubahan iklim. Artikel pertama ditulis secara profesional, jelas, terstruktur rapi, dan bebas dari kesalahan tata bahasa maupun ejaan. Artikel kedua penuh dengan salah ketik (typo), tata bahasa yang kacau, dan didominasi opini subjektif tanpa data pendukung. Berdasarkan kriteria evaluasi konten siber, apa esensi dari melakukan analisis gaya penulisan (writing style) dan kebiasaan penyajian informasi?&quot;,&quot;hint&quot;:&quot;Sumber yang dapat dipercaya umumnya menyajikan informasi secara profesional dan bebas kesalahan ketik.&quot;,&quot;choices&quot;:[&quot;Menghitung jumlah kata per menit untuk menguji efisiensi loading halaman di peramban&quot;,&quot;Memastikan bahwa penulis artikel tersebut menggunakan komputer dengan spesifikasi tinggi&quot;,&quot;Mengidentifikasi keandalan sumber, karena sumber yang dapat dipercaya cenderung mengadopsi gaya penulisan yang profesional, jelas, dan bebas kesalahan tata bahasa/ejaan&quot;,&quot;Mengubah tipe format berkas tulisan secara otomatis menjadi slide presentasi PPT&quot;,&quot;Membantu sistem menghapus data cache peramban secara berkala demi keamanan privasi&quot;],&quot;correctIndex&quot;:2},{&quot;type&quot;:&quot;pgk&quot;,&quot;question&quot;:&quot;Tentukan apakah setiap pernyataan berikut Benar atau Salah berdasarkan wacana stimulus dan materi pendukung mengenai teknik verifikasi informasi!&quot;,&quot;statements&quot;:[{&quot;text&quot;:&quot;Metode membaca vertikal lebih andal daripada membaca lateral dalam mendeteksi hoaks karena berfokus menganalisis keindahan logo dan menu internal situs asli.&quot;,&quot;answer&quot;:false},{&quot;text&quot;:&quot;Metode triangulasi mewajibkan kita mencari dan membandingkan minimal tiga sumber data atau metode independen berbeda untuk mencegah bias konfirmasi.&quot;,&quot;answer&quot;:true},{&quot;text&quot;:&quot;Teknologi Reverse Image Search bekerja dengan membandingkan file gambar yang diunggah dengan basis data gambar di internet untuk melacak asal-usulnya.&quot;,&quot;answer&quot;:true},{&quot;text&quot;:&quot;Sumber informasi siber yang kredibel akan bersikap transparan dengan memberikan informasi yang jelas tentang bagaimana mereka mendapatkan data serta menyertakan referensi atau tautan ke sumber asli.&quot;,&quot;answer&quot;:true},{&quot;text&quot;:&quot;Situs web komersial yang menyajikan klaim kesehatan sepihak demi mempromosikan produk jualan mereka tanpa menyertakan risiko secara berimbang menunjukkan tingkat objektivitas yang tinggi dan bebas dari bias potensial.&quot;,&quot;answer&quot;:false},{&quot;text&quot;:&quot;Protokol HTTPS menjamin kebenaran, keakuratan, dan validitas isi atau informasi dari konten yang ditulis di dalam sebuah website.&quot;,&quot;answer&quot;:false}]},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Seorang mahasiswa sedang menyelidiki kredibilitas artikel kesehatan tentang 'khasiat teh hijau' yang diposting di sebuah blog tidak dikenal. Manakah dua tindakan berikut yang mencerminkan penerapan taktis metode membaca lateral (lateral reading)? (Pilih dua opsi)&quot;,&quot;hint&quot;:&quot;Membaca lateral berfokus pada verifikasi reputasi dan klaim melalui tab/sumber luar.&quot;,&quot;choices&quot;:[&quot;Membaca artikel blog tersebut secara berulang-ulang dari atas ke bawah untuk memahami maknanya&quot;,&quot;Membuka tab baru di peramban untuk melacak rekam jejak, kredibilitas, dan reputasi penulis atau blog tersebut di situs web independen&quot;,&quot;Menilai tingkat kebenaran artikel berdasarkan keindahan desain visual, warna latar belakang, dan hiasan blog tersebut&quot;,&quot;Mencari klaim kesehatan yang sama di peramban luar untuk membandingkan informasi dengan situs terpercaya seperti WHO atau jurnal ilmiah&quot;,&quot;Melaporkan situs web tersebut langsung ke penyedia hosting agar situsnya diblokir secara permanen&quot;],&quot;correctAnswers&quot;:[1,3]},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Dalam menghadapi ancaman infodemi dan hoaks siber di internet, kita harus mampu mengevaluasi kredibilitas video secara kritis serta memanfaatkan ekosistem periksa fakta daring yang tersedia. Manakah dua tindakan berikut yang merupakan langkah valid dan ilmiah dalam memverifikasi keaslian konten video atau melacak kebenaran klaim di Indonesia? (Pilih dua opsi)&quot;,&quot;hint&quot;:&quot;Manfaatkan ekosistem periksa fakta lokal dan periksa tanda manipulasi/pemotongan video.&quot;,&quot;choices&quot;:[&quot;Menggunakan portal periksa fakta daring independen seperti turnbackhoax.id atau cekfakta.com untuk memverifikasi kebenaran klaim yang viral&quot;,&quot;Menganalisis konten video secara mendalam untuk mendeteksi tanda-tanda penyuntingan, manipulasi konteks, atau pemotongan (cutting) yang tidak alami&quot;,&quot;Mengandalkan durasi video yang sangat panjang sebagai jaminan mutlak bahwa isi video tersebut pasti orisinal dan bebas manipulasi&quot;,&quot;Mengunduh video tersebut secara berulang kali menggunakan jaringan internet nirkabel berkecepatan tinggi agar resolusinya meningkat secara otomatis&quot;,&quot;Melaporkan langsung pengunggah video ke penyedia hosting asing agar server website mereka diblokir tanpa verifikasi awal&quot;],&quot;correctAnswers&quot;:[0,1]},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Ketika kita mengambil foto menggunakan kamera ponsel pintar, file gambar digital yang dihasilkan akan menyimpan metadata EXIF secara otomatis. Manakah dua jenis informasi tersembunyi berikut yang dapat dibaca saat kita memeriksa metadata EXIF dari file gambar asli tersebut? (Pilih dua opsi)&quot;,&quot;hint&quot;:&quot;EXIF mencatat koordinat fisik dan keterangan waktu pengambilan gambar.&quot;,&quot;choices&quot;:[&quot;Nama lengkap dari orang-orang yang wajahnya tertangkap di dalam foto tersebut&quot;,&quot;Koordinat lokasi geografis GPS tempat foto tersebut diambil&quot;,&quot;Tanggal pembuatan dan keterangan waktu (timestamp) pemotretan&quot;,&quot;Riwayat manipulasi piksel yang dilakukan di aplikasi pihak ketiga&quot;,&quot;Sertifikat enkripsi kunci publik dari jaringan Wi-Fi pengirim&quot;],&quot;correctAnswers&quot;:[1,2]},{&quot;type&quot;:&quot;matching&quot;,&quot;question&quot;:&quot;Pasangkanlah jenis metode membaca di lajur kiri dengan karakteristik perilaku evaluasinya yang tepat di lajur kanan berdasarkan wacana Stimulus A!&quot;,&quot;leftItems&quot;:[&quot;Membaca Vertikal&quot;,&quot;Membaca Lateral&quot;],&quot;rightItems&quot;:[&quot;Melompat antar-tab peramban untuk mencari konsensus independen di luar situs web asal.&quot;,&quot;Bertahan pada satu halaman web, menilai kredibilitas dari menu About Us, logo, dan visual internal.&quot;,&quot;Menghapus data cache dan kuki peramban secara terjadwal.&quot;],&quot;correctPairs&quot;:{&quot;0&quot;:1,&quot;1&quot;:0}}]" judul="Evaluasi Kuis Interaktif" apps-script-url="https://script.google.com/macros/s/AKfycbwDq12BtYxeokfbeCuDnDo-50z0ZL-XAMlXu4fMyZbbV_el4-B-lMbMWznocusKk63D/exec" kd-materi="LM2" kategori="sumatif_lm" mode="siswa" lock-after-complete show-question-nav question-delay="1800" student-id="STD-65108053" student-name="Andy" student-nis="234" student-absen="" student-kelas="XI-1" timer-duration="1700" timer-autostart timer-minutes="28" timer-seconds="20" hide-pause-restart shuffle-choices hide-answers hide-confetti hide-score allow-backward-nav _attempt-start="1790062192635" _resume-remaining="0" _current-idx="1" _selected-answers="{}" _match-answers="{}" _answered-set="{}" _user-answers="{}" _max-points="0" _shuffled-questions="[{&quot;q&quot;:&quot;Apa kegunaan utama metode connectedCallback pada LitElement?&quot;,&quot;a&quot;:&quot;Menginisialisasi nilai variabel dasar&quot;,&quot;b&quot;:&quot;Mendeteksi elemen saat berhasil diinjeksikan ke struktur DOM&quot;,&quot;c&quot;:&quot;Menghapus event listener global&quot;,&quot;k&quot;:&quot;b&quot;,&quot;_originalIndex&quot;:0},{&quot;q&quot;:&quot;Bagaimana cara mencegah timeout 6 menit pada Google Apps Script?&quot;,&quot;a&quot;:&quot;Menggunakan penulisan masal berbasis batch I/O&quot;,&quot;b&quot;:&quot;Menulis ke banyak sheet terpisah&quot;,&quot;c&quot;:&quot;Memperbanyak rumus formula cell&quot;,&quot;k&quot;:&quot;a&quot;,&quot;_originalIndex&quot;:1}]" _temp-questions="[]" _editing-index="-1" _temp-question-type="mc" _temp-question-points="1" _temp-correct-index="0" _temp-correct-answers="[]" _temp-l