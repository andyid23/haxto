im\&quot; inurl:ac.id intext:pdf&quot;],&quot;correctIndex&quot;:2,&quot;points&quot;:1},{&quot;type&quot;:&quot;pgk&quot;,&quot;question&quot;:&quot;Berdasarkan wacana Stimulus 1, tentukan apakah setiap pernyataan berikut Benar atau Salah mengenai penggunaan variabel dan strategi pencarian lanjutan di Google!&quot;,&quot;statements&quot;:[{&quot;text&quot;:&quot;Penggunaan kata kunci pencarian yang sangat spesifik (terlalu sempit) dijamin selalu menghasilkan informasi yang paling relevan dan tidak akan menghilangkan informasi penting lainnya.&quot;,&quot;answer&quot;:false},{&quot;text&quot;:&quot;Variabel inurl:karir akan menampilkan halaman web yang alamat URL-nya mengandung kata \&quot;karir\&quot;, sedangkan intitle:lowongan akan mencari halaman yang judul dokumennya memuat kata \&quot;lowongan\&quot;.&quot;,&quot;answer&quot;:true},{&quot;text&quot;:&quot;Operator boolean \&quot;OR\&quot; digunakan untuk mempersempit hasil pencarian dengan mengecualikan kata kunci tertentu yang tidak relevan dari halaman pencarian.&quot;,&quot;answer&quot;:false}],&quot;points&quot;:3},{&quot;type&quot;:&quot;matching&quot;,&quot;question&quot;:&quot;Pasangkanlah nama variabel pencarian lanjutan Google di lajur kiri dengan fungsi penjelasannya yang tepat di lajur kanan!&quot;,&quot;leftItems&quot;:[&quot;site:&quot;,&quot;cache:&quot;,&quot;intext:&quot;],&quot;rightItems&quot;:[&quot;Mencari kata kunci khusus di dalam badan teks (body) halaman web&quot;,&quot;Membatasi pencarian pada konten yang muncul di alamat website/domain tertentu&quot;,&quot;Menampilkan versi salinan sementara terbaru dari halaman web tertentu yang disimpan Google&quot;,&quot;Menyaring hasil pencarian berdasarkan format file dokumen tertentu seperti PDF atau DOC&quot;],&quot;correctPairs&quot;:{&quot;0&quot;:1,&quot;1&quot;:2,&quot;2&quot;:0},&quot;points&quot;:3},{&quot;type&quot;:&quot;shortAnswer&quot;,&quot;question&quot;:&quot;Anda ingin mencari panduan belajar pemrograman bahasa Python yang khusus diterbitkan di situs resmi Kementerian Komunikasi dan Informatika Indonesia (domain: kominfo.go.id) dengan format dokumen berupa presentasi PowerPoint (ppt). Tuliskan sintaks pencarian lanjutan Google yang paling tepat dan efisien untuk kasus tersebut!&quot;,&quot;acceptedAnswers&quot;:[&quot;python site:kominfo.go.id filetype:ppt&quot;,&quot;\&quot;python\&quot; site:kominfo.go.id filetype:ppt&quot;],&quot;points&quot;:1},{&quot;type&quot;:&quot;mc&quot;,&quot;question&quot;:&quot;Berdasarkan wacana Stimulus 2, mengapa era jurnalisme digital memiliki risiko penyebaran informasi palsu (disinformasi/hoaks) yang jauh lebih tinggi dibandingkan era jurnalisme tradisional?&quot;,&quot;choices&quot;:[&quot;Karena teknologi internet membatasi akses masyarakat terhadap kanal berita resmi pemerintah.&quot;,&quot;Karena organisasi periksa fakta tidak memiliki teknologi AI untuk memantau semua situs web.&quot;,&quot;Karena jurnalisme digital memungkinkan lebih banyak orang untuk memublikasikan konten secara instan tanpa pelatihan formal dan penyaringan ketat.&quot;,&quot;Karena UU ITE membebaskan penyebaran opini subjektif di media sosial tanpa sanksi hukum.&quot;,&quot;Karena platform media sosial secara aktif memblokir semua berita yang bersifat objektif.&quot;],&quot;correctIndex&quot;:2,&quot;points&quot;:1},{&quot;type&quot;:&quot;pgk&quot;,&quot;question&quot;:&quot;Gunakan wacana Stimulus 2 untuk menilai apakah pernyataan-pernyataan berikut Benar atau Salah terkait tanggung jawab platform media sosial dan regulasi hukum di Indonesia!&quot;,&quot;statements&quot;:[{&quot;text&quot;:&quot;Jika sebuah informasi palsu yang membahayakan publik masih menyebar luas di internet meskipun telah dinyatakan hoaks oleh organisasi periksa fakta, platform media sosial dapat dinilai gagal membatasi penyebaran konten tersebut.&quot;,&quot;answer&quot;:true},{&quot;text&quot;:&quot;Undang-Undang No. 11 Tahun 2008 (UU ITE) khususnya Pasal 45A ayat (1) merupakan salah satu instrumen hukum